# Fracture configuration
# Copy to fracture.env and edit for your cluster.
# CLI flags override values set here.

# ── Model ────────────────────────────────────────────────────────────────
FRACTURE_MODEL=/path/to/llama-3-8b.gguf

# ── Coordinator ──────────────────────────────────────────────────────────
# Address the coordinator listens on for worker connections.
FRACTURE_LISTEN=0.0.0.0:9400

# HTTP API port for client requests.
FRACTURE_HTTP_PORT=8080

# Minimum workers before building the initial pipeline.
# Additional workers join dynamically. Default: 1.
FRACTURE_MIN_WORKERS=1

# ── Worker ───────────────────────────────────────────────────────────────
# Direct coordinator address (use this OR FRACTURE_SEEDS, not both).
# FRACTURE_COORDINATOR=192.168.1.10:9400

# Seed nodes for coordinator discovery. Comma-separated.
# The worker queries each seed to find the current coordinator.
# Any node (coordinator or worker) can be a seed.
FRACTURE_SEEDS=192.168.1.10:9400,192.168.1.20:9401

# Port for peer connections (seed discovery, election). 0 = OS-assigned.
FRACTURE_PEER_PORT=9401
